   "source": [
    "# Serve one model: llama-server across both T4s behind ngrok. Inference only: no agents, git or tests run here.\n",
    "import contextlib\n",
    "import glob\n",
    "import hashlib\n",
    "import json\n",
    "import os\n",
    "import re\n",
    "import shutil\n",
    "import subprocess\n",
    "import sys\n",
    "import tarfile\n",
    "import tempfile\n",
    "import threading\n",
    "import time\n",
    "import traceback\n",
    "import urllib.request\n",
    "from io import BytesIO, StringIO\n",
    "\n",
    "PORT = 8080\n",
    "FAILED = (\"load\", \"error\")  # exits that are failures; idle, hard and bound are the planned ways out\n",
    "KEY_SHAPE = re.compile(r\"[A-Za-z0-9_-]{32,200}\")\n",
    "TOKEN_SHAPE = re.compile(r\"[A-Za-z0-9_-]{20,200}\")\n",
    "HOST_SHAPE = re.compile(r\"https://([A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)+)/?\")\n",
    "# Seconds a setup step may take before it is a failure (a cold llama.cpp build measured 29 minutes in all).\n",
    "PIP_S, FETCH_S, CONFIGURE_S, BUILD_S, DOWNLOAD_S = 600, 600, 900, 3600, 3600\n",
    "NGROK_S = 120  # opening the tunnel\n",
    "FETCH_CODE = (\n",
    "    \"import shutil, sys, urllib.request\\n\"\n",
    "    \"with urllib.request.urlopen(sys.argv[1], timeout=60) as res, open(sys.argv[2], 'wb') as out:\\n\"\n",
    "    \"    shutil.copyfileobj(res, out)\\n\"\n",
    ")\n",
    "DOWNLOAD_CODE = (\n",
    "    \"import sys\\n\"\n",
    "    \"from huggingface_hub import hf_hub_download\\n\"\n",
    "    \"print(hf_hub_download(sys.argv[1], sys.argv[2], revision=sys.argv[3], local_dir=sys.argv[4]))\\n\"\n",
    ")\n",
    "\n",
    "\n",
    "class Failure(Exception):\n",
    "    \"\"\"A start that cannot go on. The message never holds a secret's value.\"\"\"\n",
    "\n",
    "\n",
    "def server_argv(binary, model, key_file, spec, port=PORT):\n",
    "    \"\"\"llama-server with the flags the catalog measured (spec[\"flags\"]). The key is a file path, never a value: argv shows in `ps`.\"\"\"\n",
    "    return [binary, \"-m\", model, \"--host\", \"127.0.0.1\", \"--port\", str(port), *spec[\"flags\"],\n",
    "            \"--parallel\", str(spec[\"slots\"]), \"-c\", str(spec[\"ctx\"] * spec[\"slots\"]),\n",
    "            \"--api-key-file\", key_file, \"--metrics\", \"--jinja\"]\n",
    "\n",
    "\n",
    "def write_key_file(key):\n",
    "    \"\"\"The key in a 0600 file inside a 0700 directory; returns (directory, file).\"\"\"\n",
    "    folder = tempfile.mkdtemp(prefix=\"pivotal-\")\n",
    "    path = os.path.join(folder, \"key\")\n",
    "    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)\n",
    "    with os.fdopen(fd, \"w\") as fh:\n",
    "        fh.write(key)\n",
    "    return folder, path\n",
    "\n",
    "\n",
    "def parse_secrets(text):\n",
    "    \"\"\"(domain, key, token) from serve.json, the file piv kaggle setup wrote. Failure messages name no value.\"\"\"\n",
    "    try:\n",
    "        data = json.loads(text)\n",
    "    except ValueError:\n",
    "        raise Failure(\"the private dataset's serve file is not JSON\") from None\n",
    "    if not isinstance(data, dict):\n",
    "        raise Failure(\"the private dataset's serve file is not an object\")\n",
    "    url, key, token = (data.get(name) for name in (\"endpoint_url\", \"endpoint_key\", \"ngrok_authtoken\"))\n",
    "    host = HOST_SHAPE.fullmatch(url) if isinstance(url, str) else None\n",
    "    if not host:\n",
    "        raise Failure(\"endpoint_url in the private dataset is not an https address\")\n",
    "    if not isinstance(key, str) or not KEY_SHAPE.fullmatch(key):\n",
    "        raise Failure(\"endpoint_key in the private dataset is missing or malformed\")\n",
    "    if not isinstance(token, str) or not TOKEN_SHAPE.fullmatch(token):\n",
    "        raise Failure(\"ngrok_authtoken in the private dataset is missing or malformed\")\n",
    "    return host.group(1), key, token\n",
    "\n",
    "\n",
    "def unpack(data, dest):\n",
    "    \"\"\"Extract a .tar.gz held in memory under dest, dropping the top directory. Only plain files and directories, and\n",
    "    nothing that leaves dest: a link or a '..' in an archive is skipped or refused.\"\"\"\n",
    "    root = os.path.realpath(dest)\n",
    "    with tarfile.open(fileobj=BytesIO(data), mode=\"r:gz\") as tar:\n",
    "        for member in tar:\n",
    "            parts = member.name.split(\"/\")[1:]\n",
    "            if not parts or not any(parts):\n",
    "                continue\n",
    "            target = os.path.realpath(os.path.join(root, *parts))\n",
    "            if \"..\" in parts or not target.startswith(root + os.sep):\n",
    "                raise Failure(\"the llama.cpp archive holds a path outside its directory\")\n",
    "            if member.isdir():\n",
    "                os.makedirs(target, exist_ok=True)\n",
    "            elif member.isreg():\n",
    "                os.makedirs(os.path.dirname(target), exist_ok=True)\n",
    "                with open(target, \"wb\") as out:\n",
    "                    shutil.copyfileobj(tar.extractfile(member), out)\n",
    "                os.chmod(target, member.mode & 0o755 | 0o600)\n",
    "\n",
    "\n",
    "@contextlib.contextmanager\n",
    "def captured(sink):\n",
    "    \"\"\"Everything written to stdout and stderr inside the block, by Python or by native code (the ngrok SDK), goes\n",
    "    to a temp file, and ``sink(text)`` gets it afterwards. ``sink`` is the redacting say.\"\"\"\n",
    "    buf = StringIO()\n",
    "    sys.stdout.flush()\n",
    "    sys.stderr.flush()\n",
    "    saved = os.dup(1), os.dup(2)\n",
    "    with tempfile.TemporaryFile() as fh:\n",
    "        os.dup2(fh.fileno(), 1)\n",
    "        os.dup2(fh.fileno(), 2)\n",
    "        try:\n",
    "            with contextlib.redirect_stdout(buf), contextlib.redirect_stderr(buf):\n",
    "                yield\n",
    "        finally:\n",
    "            os.dup2(saved[0], 1)\n",
    "            os.dup2(saved[1], 2)\n",
    "            os.close(saved[0])\n",
    "            os.close(saved[1])\n",
    "            fh.seek(0)\n",
    "            text = fh.read().decode(\"utf-8\", \"replace\") + buf.getvalue()\n",
    "            if text.strip():\n",
    "                sink(text)\n",
    "\n",
    "\n",
    "class Io:\n",
    "    \"\"\"What the notebook does to the world. Tests replace this whole class.\"\"\"\n",
    "\n",
    "    def __init__(self, spec, root=\"/kaggle\", tmp=\"/tmp\"):\n",
    "        self.spec, self.root, self.tmp, self.hidden = spec, root, tmp, []\n",
    "\n",
    "    def now(self):\n",
    "        return time.monotonic()\n",
    "\n",
    "    def sleep(self, seconds):\n",
    "        time.sleep(seconds)\n",
    "\n",
    "    def hide(self, *values):\n",
    "        self.hidden.extend(values)\n",
    "\n",
    "    def say(self, line):\n",
    "        print(redact(str(line), self.hidden), flush=True)\n",
    "\n",
    "    def tail(self, text, size=2000):\n",
    "        \"\"\"The last ``size`` characters, cut AFTER the secrets are masked so none is cut in half and left.\"\"\"\n",
    "        return redact(text, self.hidden)[-size:]\n",
    "\n",
    "    def run(self, argv, timeout):\n",
    "        \"\"\"A setup command with a time limit. Its output is kept off the log; a failure shows a masked tail.\"\"\"\n",
    "        done = subprocess.run(argv, capture_output=True, text=True, errors=\"replace\", timeout=timeout, check=False)\n",
    "        if done.returncode != 0:\n",
    "            raise Failure(f\"{os.path.basename(argv[0])} exited {done.returncode}:\\n\" + self.tail(done.stderr + done.stdout))\n",
    "        return done.stdout\n",
    "\n",
    "    def pip(self, requirement):\n",
    "        self.run([sys.executable, \"-m\", \"pip\", \"install\", \"-q\", requirement], PIP_S)\n",
    "\n",
    "    def read_secrets(self):\n",
    "        # Kaggle Secrets do not reach a CLI-pushed notebook: the private dataset is the only way in.\n",
    "        found = glob.glob(f\"{self.root}/input/**/{self.spec['serve_file']}\", recursive=True)\n",
    "        if len(found) != 1:\n",
    "            raise Failure(f\"expected exactly one {self.spec['serve_file']} in the attached datasets, found {len(found)}\")\n",
    "        with open(found[0], encoding=\"utf-8\") as fh:\n",
    "            return parse_secrets(fh.read())\n",
    "\n",
    "    def open_tunnel(self, port, token, domain):\n",
    "        self.pip(f\"ngrok=={self.spec['pins']['ngrok']}\")\n",
    "        # Measured live: in a notebook session an event loop is already running, and ngrok.forward then returns an\n",
    "        # un-awaited asyncio Task, not a listener: the notebook said \"tunnel up\" and the domain stayed offline. In a\n",
    "        # plain thread there is no running loop, so forward opens the tunnel and returns the listener.\n",
    "        done = {}\n",
    "\n",
    "        def open_it():\n",
    "            try:\n",
    "                import ngrok\n",
    "                done[\"listener\"] = ngrok.forward(port, authtoken=token, domain=domain)\n",
    "            except BaseException as err:  # noqa: BLE001 - re-raised below, in the caller's thread\n",
    "                done[\"error\"] = err\n",
    "\n",
    "        with captured(self.say):  # the SDK prints from native code; none of it bypasses the redactor\n",
    "            worker = threading.Thread(target=open_it, daemon=True)\n",
    "            worker.start()\n",
    "            worker.join(NGROK_S)\n",
    "        if \"error\" in done:\n",
    "            raise done[\"error\"]\n",
    "        listener = done.get(\"listener\")\n",
    "        if listener is None or not callable(getattr(listener, \"url\", None)):\n",
    "            raise Failure(\"ngrok did not return an open tunnel\")\n",
    "        self.tunnel = listener\n",
    "\n",
    "    def close_tunnel(self):\n",
    "        try:\n",
    "            with captured(self.say):  # the SDK may still print from native code: through the redactor too\n",
    "                import ngrok\n",
    "                ngrok.kill()\n",
    "        except Exception:  # noqa: BLE001 - leaving is best effort; the session ends anyway\n",
    "            pass\n",
    "\n",
    "    def fetch(self, url, limit_s):\n",
    "        \"\"\"The bytes at url, in a subprocess that is killed at limit_s seconds in all, however slowly the server sends.\"\"\"\n",
    "        path = f\"{self.tmp}/llama.tar.gz\"\n",
    "        try:\n",
    "            self.run([sys.executable, \"-c\", FETCH_CODE, url, path], limit_s)\n",
    "            with open(path, \"rb\") as fh:\n",
    "                return fh.read()\n",
    "        finally:\n",
    "            if os.path.exists(path):\n",
    "                os.remove(path)\n",
    "\n",
    "    def engine(self):\n",
    "        cached = [p for p in glob.glob(f\"{self.root}/input/**/llama-server\", recursive=True) if os.path.getsize(p) > 0]\n",
    "        if cached:\n",
    "            os.makedirs(f\"{self.tmp}/llama/bin\", exist_ok=True)\n",
    "            shutil.copy(cached[0], f\"{self.tmp}/llama/bin/llama-server\")\n",
    "            os.chmod(f\"{self.tmp}/llama/bin/llama-server\", 0o755)\n",
    "            return f\"{self.tmp}/llama/bin/llama-server\"\n",
    "        pins = self.spec[\"pins\"]\n",
    "        data = self.fetch(f\"https://github.com/ggml-org/llama.cpp/archive/{pins['llama_commit']}.tar.gz\", FETCH_S)\n",
    "        if hashlib.sha256(data).hexdigest() != pins[\"llama_sha256\"]:\n",
    "            raise Failure(\"the llama.cpp archive does not match its pinned sha256\")\n",
    "        src = f\"{self.tmp}/llama.cpp\"\n",
    "        unpack(data, src)\n",
    "        self.run([\"cmake\", \"-S\", src, \"-B\", f\"{src}/build\", \"-DGGML_CUDA=ON\", \"-DGGML_CUDA_NO_VMM=ON\",\n",
    "                  \"-DBUILD_SHARED_LIBS=OFF\", \"-DCMAKE_CUDA_ARCHITECTURES=75\", \"-DLLAMA_CURL=OFF\",\n",
    "                  \"-DCMAKE_BUILD_TYPE=Release\", \"-DCMAKE_LIBRARY_PATH=/usr/local/cuda/lib64/stubs\"], CONFIGURE_S)\n",
    "        self.run([\"cmake\", \"--build\", f\"{src}/build\", \"--target\", \"llama-server\", \"-j\", \"4\"], BUILD_S)  # the engine only\n",
    "        try:\n",
    "            os.makedirs(f\"{self.root}/working\", exist_ok=True)\n",
    "            shutil.copy(f\"{src}/build/bin/llama-server\", f\"{self.root}/working/llama-server\")\n",
    "            self.say(\"saved engine to output\")\n",
    "        except OSError:\n",
    "            pass\n",
    "        return f\"{src}/build/bin/llama-server\"\n",
    "\n",
    "    def download(self, repo, file):\n",
    "        pins = self.spec[\"pins\"]\n",
    "        self.pip(f\"huggingface_hub=={pins['huggingface_hub']}\")\n",
    "        out = self.run([sys.executable, \"-c\", DOWNLOAD_CODE, repo, file, pins[\"revision\"], f\"{self.tmp}/model\"], DOWNLOAD_S)\n",
    "        return out.strip().splitlines()[-1]\n",
    "\n",
    "    def launch(self, argv):\n",
    "        self.log = open(f\"{self.tmp}/server.log\", \"w\")  # the server's log stays on disk; only a redacted tail is printed\n",
    "        # Measured live (2026-11): the session image has CUDA 13 under /usr/local/cuda, and a llama-server built against\n",
    "        # CUDA 12 needs libcudart.so.12 and libcublas.so.12, which the image's Python nvidia packages carry. The inherited\n",
    "        # path stays first (it carries the driver, libcuda.so.1); a missing directory is harmless.\n",
    "        env = dict(os.environ)\n",
    "        extra = sorted(glob.glob(\"/usr/local/lib/python3*/dist-packages/nvidia/*/lib\"))\n",
    "        env[\"LD_LIBRARY_PATH\"] = \":\".join(p for p in [env.get(\"LD_LIBRARY_PATH\"), \"/usr/local/cuda/lib64\", *extra] if p)\n",
    "        return subprocess.Popen(argv, stdout=self.log, stderr=subprocess.STDOUT, env=env)\n",
    "\n",
    "    def log_tail(self):\n",
    "        try:\n",
    "            with open(f\"{self.tmp}/server.log\", \"rb\") as fh:\n",
    "                fh.seek(0, os.SEEK_END)\n",
    "                fh.seek(max(0, fh.tell() - 8192))\n",
    "                return self.tail(fh.read().decode(\"utf-8\", \"replace\"))\n",
    "        except OSError:\n",
    "            return \"\"\n",
    "\n",
    "    def healthy(self, port):\n",
    "        try:\n",
    "            return urllib.request.urlopen(f\"http://127.0.0.1:{port}/health\", timeout=5).status == 200\n",
    "        except Exception:  # noqa: BLE001 - still loading\n",
    "            return False\n",
    "\n",
    "    def sample(self, port, key):\n",
    "        req = urllib.request.Request(f\"http://127.0.0.1:{port}/metrics\", headers={\"Authorization\": f\"Bearer {key}\"})\n",
    "        try:\n",
    "            return parse_activity(urllib.request.urlopen(req, timeout=5).read().decode(\"utf-8\", \"replace\"))\n",
    "        except Exception:  # noqa: BLE001 - no sample is no activity\n",
    "            return None\n",
    "\n",
    "    def gpu_memory(self):\n",
    "        out = subprocess.run([\"nvidia-smi\", \"--query-gpu=memory.used\", \"--format=csv,noheader,nounits\"],\n",
    "                             capture_output=True, text=True, check=False, timeout=30).stdout\n",
    "        return [int(line) for line in out.split() if line.isdigit()]\n",
    "\n",
    "\n",
    "def main(io=None):\n",
    "    \"\"\"Start, serve, and leave: returns why it ended ('idle', 'hard', 'bound', 'load' or 'error').\"\"\"\n",
    "    io = io or Io(SPEC)\n",
    "    dog = Watchdog(io.now)\n",
    "    server, folder = None, None\n",
    "\n",
    "    def out_of_time():\n",
    "        # Between setup steps only the hard limit counts; the load budget starts at the launch.\n",
    "        if dog.verdict() == \"hard\":\n",
    "            io.say(\"EXIT hard: the time limit passed during setup\")\n",
    "            return True\n",
    "        return False\n",
    "\n",
    "    try:\n",
    "        domain, key, token = io.read_secrets()\n",
    "        io.hide(key, token)\n",
    "        io.say(f\"serve {SPEC['id']} for {SPEC['slots']} slots of {SPEC['ctx']} tokens\")\n",
    "        try:\n",
    "            io.open_tunnel(PORT, token, domain)  # first: a bound domain costs no model load\n",
    "        except Exception as err:  # noqa: BLE001 - classified below\n",
    "            if domain_bound(str(err)):\n",
    "                io.say(\"EXIT bound: the static domain is already online, so another session serves; this one stops\")\n",
    "                return \"bound\"\n",
    "            raise\n",
    "        io.say(\"tunnel up on the static domain\")\n",
    "        if out_of_time():\n",
    "            return \"hard\"\n",
    "        binary = io.engine()\n",
    "        if out_of_time():\n",
    "            return \"hard\"\n",
    "        model = io.download(SPEC[\"repo\"], SPEC[\"file\"])\n",
    "        if out_of_time():\n",
    "            return \"hard\"\n",
    "        folder, key_file = write_key_file(key)\n",
    "        dog.launched()  # the load budget starts here, after the engine build and the download\n",
    "        server = io.launch(server_argv(binary, model, key_file, SPEC))\n",
    "        while not io.healthy(PORT):\n",
    "            if server.poll() is not None:\n",
    "                io.say(\"llama-server exited:\\n\" + io.log_tail())\n",
    "                return \"error\"\n",
    "            reason = dog.verdict()\n",
    "            if reason:\n",
    "                io.say(f\"EXIT {reason}: llama-server was not healthy in time\\n\" + io.log_tail())\n",
    "                return reason\n",
    "            io.sleep(3)\n",
    "        memory = io.gpu_memory()\n",
    "        io.say(f\"gpu memory in use (MiB): {memory}\")\n",
    "        if not any(memory):\n",
    "            io.say(\"EXIT error: the model did not reach a GPU; a CPU fallback would burn quota\")\n",
    "            return \"error\"\n",
    "        dog.ready()\n",
    "        io.say(\"READY\")\n",
    "        reason = watch(dog, lambda: io.sample(PORT, key), io.sleep, alive=lambda: server.poll() is None)\n",
    "        io.say(f\"EXIT {reason}\" + (\"\\n\" + io.log_tail() if reason == \"error\" else \"\"))\n",
    "        return reason\n",
    "    except Exception:  # noqa: BLE001 - printed through the redactor, then reported as a failed run\n",
    "        io.say(\"EXIT error:\\n\" + traceback.format_exc())\n",
    "        return \"error\"\n",
    "    finally:\n",
    "        if server is not None and server.poll() is None:\n",
    "            server.terminate()\n",
    "            try:\n",
    "                server.wait(timeout=10)\n",
    "            except subprocess.TimeoutExpired:\n",
    "                server.kill()\n",
    "        io.close_tunnel()\n",
    "        if folder:\n",
    "            shutil.rmtree(folder, ignore_errors=True)\n"
   ]
  },
