   "source": [
    "# Rendered by kaggle/render.py from kaggle/catalog.json: validated values only, one JSON string.\n",
    "import json\n",
    "SPEC = json.loads(__SPEC__)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
